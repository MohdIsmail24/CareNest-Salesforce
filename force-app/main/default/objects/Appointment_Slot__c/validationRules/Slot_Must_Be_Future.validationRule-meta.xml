<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Slot_Must_Be_Future</fullName>
    <active>true</active>
    <description>Slot start time must be in the future upon creation.</description>
    <errorConditionFormula>AND(ISNEW(), Slot_Start__c &lt;= NOW())</errorConditionFormula>
    <errorDisplayField>Slot_Start__c</errorDisplayField>
    <errorMessage>Slot start time must be in the future.</errorMessage>
</ValidationRule>
